# INSAN Platform — Production Environment Variables
# Copy to .env.production and fill in all values before deploying.

# ---- General ----
NODE_ENV=production
PORT=4000

# ---- Database ----
# For production: use a managed provider (Supabase, Neon, Railway, AWS RDS).
# The bundled db service in docker-compose.prod.yml is for dev/testing only.
# If using a managed provider, remove the db service from docker-compose.prod.yml.
DATABASE_URL=postgresql://insan:CHANGE_ME@db:5432/insan
POSTGRES_USER=insan
POSTGRES_PASSWORD=CHANGE_ME

# ---- JWT Secrets ----
# Generate with: openssl rand -base64 32
# MUST be different from development values
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- CORS ----
# Production frontend origin (e.g., https://insan-platform.com)
CORS_ORIGIN=https://insan-platform.com

# ---- Encryption ----
# Used to encrypt integration secrets (Facebook tokens, etc.) at rest.
# Generate with: openssl rand -base64 32
# MUST be different from development values. The app refuses to start in
# production without this set.
ENCRYPTION_KEY=CHANGE_ME_MIN_32_CHARS

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=https://insan-platform.com/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SITE_URL=https://insan-platform.com

# ═══════════════════════════════════════════════════════════════════════
# Healthcare AI Layer (receptionist)
# See receptionist/docs/ARCHITECTURE.md and receptionist/docs/OPERATOR_SETUP.md
# ═══════════════════════════════════════════════════════════════════════

# ---- Data mode ----
# PROVISIONAL (default) — the knowledge base still holds unverified or
#   conflicting facts. The web widget works; public channels (Messenger,
#   WhatsApp, Instagram, voice) are REFUSED. Development happens here.
# VERIFIED — the operator has signed off. Public channels are permitted.
# Anything other than the literal string VERIFIED is treated as PROVISIONAL.
RECEPTIONIST_DATA_MODE=PROVISIONAL

# ---- Model ----
# The key can live here OR as an active AiProvider row named "anthropic" in the
# admin dashboard, where it is stored masked. The code checks both.
# NEVER commit a real key: .env.production is tracked in git on a public repo.
ANTHROPIC_API_KEY=

# One model per conversation — switching mid-conversation invalidates the
# entire prompt cache and costs more than it saves.
RECEPTIONIST_MODEL=claude-sonnet-5
# Side tasks with their own small prompts: classification, summarisation.
RECEPTIONIST_UTILITY_MODEL=claude-haiku-4-5

# ---- Spend ceilings ----
# Both fail closed: over the limit, the conversation is handed to a human
# rather than sent to the model again.
RECEPTIONIST_MAX_REPLIES_PER_CONVERSATION=60
# ~$6/day at Sonnet 5 output rates.
RECEPTIONIST_MAX_DAILY_OUTPUT_TOKENS=400000

# ---- Content paths ----
# Personas, safety lexicons and hospital facts live in the repo root, outside
# apps/api. Set these when the API is deployed from a directory that does not
# contain the receptionist/ folder.
# RECEPTIONIST_SAFETY_DIR=/srv/insan/receptionist/safety
# RECEPTIONIST_DATA_DIR=/srv/insan/receptionist/data
# RECEPTIONIST_PROMPTS_DIR=/srv/insan/receptionist/prompts

# ---- Facebook Messenger ----
# One app, three pages. Business Verification is the critical path — start it
# first; it takes 1–3 weeks. See receptionist/docs/OPERATOR_SETUP.md §2.
FB_APP_SECRET=
# A string you choose. Must match what is entered in the Meta webhook form.
FB_VERIFY_TOKEN=

# Page tokens, either as one map or one variable per page id.
#   FB_PAGE_TOKENS=<pageId>:<token>,<pageId>:<token>
# or
#   FB_PAGE_TOKEN_<pageId>=<token>
FB_PAGE_TOKENS=

# ---- Lead notifications ----
# Routed per hospital so a Future lead never pages Delta's desk. Without these
# the lead is still saved and visible in /admin/appointments — nobody is paged.
RECEPTIONIST_TELEGRAM_BOT_TOKEN=
RECEPTIONIST_TELEGRAM_FUTURE_HOSPITAL=
RECEPTIONIST_TELEGRAM_DELTA_HOSPITAL=
RECEPTIONIST_TELEGRAM_INSAN=
RECEPTIONIST_TELEGRAM_DEFAULT=

# ---- Retention ----
# Egypt's Personal Data Protection Law 151/2020. Conversations older than this
# are anonymised; the AppointmentRequest they produced is a business record and
# is kept. 0 disables the job.
RECEPTIONIST_RETENTION_DAYS=365
