# INSAN Platform — Production Environment Variables
# Copy to .env.production and fill in all values before deploying.

# ---- General ----
NODE_ENV=production
PORT=4000

# ---- Database ----
# For production: use a managed provider (Supabase, Neon, Railway, AWS RDS).
# The bundled db service in docker-compose.prod.yml is for dev/testing only.
# If using a managed provider, remove the db service from docker-compose.prod.yml.
DATABASE_URL=postgresql://insan:CHANGE_ME@db:5432/insan
POSTGRES_USER=insan
POSTGRES_PASSWORD=CHANGE_ME

# ---- JWT Secrets ----
# Generate with: openssl rand -base64 32
# MUST be different from development values
JWT_ACCESS_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_REFRESH_SECRET=CHANGE_ME_MIN_32_CHARS
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- CORS ----
# Production frontend origin (e.g., https://insan-platform.com)
CORS_ORIGIN=https://insan-platform.com

# ---- Encryption ----
# Used to encrypt integration secrets (Facebook tokens, etc.) at rest.
# Generate with: openssl rand -base64 32
# MUST be different from development values. The app refuses to start in
# production without this set.
ENCRYPTION_KEY=CHANGE_ME_MIN_32_CHARS

# ---- Frontend ----
NEXT_PUBLIC_API_BASE_URL=https://insan-platform.com/api/v1
NEXT_PUBLIC_DEFAULT_LOCALE=ar
NEXT_PUBLIC_SITE_URL=https://insan-platform.com
