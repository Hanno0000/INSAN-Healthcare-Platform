generator client {
  provider = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  directUrl  = env("DIRECT_URL")
  extensions = [vector]
}

model Role {
  id          String   @id @default(cuid())
  name        RoleName @unique
  permissions Json
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  users       User[]
}

model User {
  id            String         @id @default(cuid())
  name          String
  email         String         @unique
  passwordHash  String
  roleId        String
  isActive      Boolean        @default(true)
  avatarUrl     String?
  lastLoginAt   DateTime?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  auditLogs     AuditLog[]
  refreshTokens RefreshToken[]
  role          Role           @relation(fields: [roleId], references: [id])

  @@index([roleId])
  @@index([email])
}

model RefreshToken {
  id        String   @id @default(cuid())
  tokenHash String   @unique
  userId    String
  userAgent String?
  ipAddress String?
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Page {
  id              String        @id @default(cuid())
  slug            String        @unique
  type            String        @default("standard")
  title           Json
  status          ContentStatus @default(DRAFT)
  metaTitle       Json?
  metaDescription Json?
  ogImage         String?
  canonicalUrl    String?
  robotsIndex     Boolean       @default(true)
  customFields    Json?         @default("{}")
  createdBy       String?
  updatedBy       String?
  publishedAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  drafts          PageDraft[]
  sections        Section[]

  @@index([status])
  @@index([slug])
}

model PageDraft {
  id      String   @id @default(cuid())
  pageId  String
  content Json
  savedAt DateTime @default(now())
  savedBy String?
  page    Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId])
}

model Section {
  id            String   @id @default(cuid())
  pageId        String
  componentType String
  order         Int
  isVisible     Boolean  @default(true)
  config        Json
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  page          Page     @relation(fields: [pageId], references: [id], onDelete: Cascade)

  @@index([pageId, order])
}

model InvestorsPage {
  id            String   @id @default(cuid())
  heroTitle     String
  htmlContent   String
  ctaButtonText String   @default("اعرف أكتر")
  ctaButtonLink String
  heroImage     String?
  videoUrl      String?
  isPublished   Boolean  @default(false)
  updatedAt     DateTime @updatedAt
  createdAt     DateTime @default(now())
}

model SlugHistory {
  id        String   @id @default(cuid())
  entity    String
  entityId  String
  oldSlug   String
  newSlug   String
  changedAt DateTime @default(now())

  @@index([entity, entityId])
  @@index([oldSlug])
}

model Redirect {
  id         String    @id @default(cuid())
  fromPath   String    @unique
  toPath     String
  statusCode Int       @default(301)
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([fromPath])
}

model Brand {
  id             String               @id @default(cuid())
  code           String               @unique
  displayName    Json
  isActive       Boolean              @default(true)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  socialAccounts BrandSocialAccount[]
  newsPosts      NewsPost[]
  conversations  ChatConversation[]
  persona        BrandPersona?

  @@index([isActive])
}

model BrandSocialAccount {
  id                   String              @id @default(cuid())
  brandId              String
  platform             SocialPlatform
  pageId               String
  pageName             String
  username             String?
  integrationSettingId String?
  isPrimary            Boolean             @default(false)
  isActive             Boolean             @default(true)
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  brand                Brand               @relation(fields: [brandId], references: [id], onDelete: Cascade)
  integrationSetting   IntegrationSetting? @relation(fields: [integrationSettingId], references: [id])

  @@unique([brandId, platform])
  @@index([brandId])
  @@index([isActive])
}

model FeatureFlag {
  key         String   @id
  isEnabled   Boolean  @default(false)
  description String?
  updatedAt   DateTime @updatedAt
}

model Hospital {
  id               String                  @id @default(cuid())
  slug             String                  @unique
  name             Json
  shortDescription Json?
  description      Json?
  logoUrl          String?
  heroImage        String?
  brandColor       String?
  googleMapsUrl    String?
  // ─── حقول صفحة المستشفى الجديدة (6) ───
  heroTagline      Json?
  heroStats        Json?
  departments      Json?
  locations        Json?
  contactInfo      Json?
  journeySteps     Json?
  // ──────────────────────────────────────
  status           ContentStatus           @default(DRAFT)
  metaTitle        Json?
  metaDescription  Json?
  customFields     Json?                   @default("{}")
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt
  appointments     AppointmentRequest[]
  clinics          Clinic[]
  doctors          DoctorHospital[]
  medicalCenters   HospitalMedicalCenter[]
  newsPosts        NewsPost[]
  serviceAreas     ServiceArea[]
  conversations    ChatConversation[]

  @@index([status])
}

enum CenterType {
  CENTER
  DEPARTMENT
  PROGRAM
}

model MedicalCenter {
  id              String                  @id @default(cuid())
  registryId      String?                 @unique
  slug            String                  @unique
  name            Json
  shortDescription Json?
  description     Json?
  type            CenterType              @default(CENTER)
  features        Json?
  services        Json?
  logoUrl         String?
  heroImage       String?
  brandColor      String?
  isFeatured      Boolean                 @default(false)
  status          ContentStatus           @default(DRAFT)
  metaTitle       Json?
  metaDescription Json?
  customFields    Json?                   @default("{}")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt
  appointments    AppointmentRequest[]
  clinics         Clinic[]
  bookingQuestions BookingQuestion[]
  doctors         DoctorMedicalCenter[]
  hospitals       HospitalMedicalCenter[]

  @@index([status])
  @@index([isFeatured])
}

model HospitalMedicalCenter {
  hospitalId      String
  medicalCenterId String
  createdAt       DateTime      @default(now())
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  medicalCenter   MedicalCenter @relation(fields: [medicalCenterId], references: [id], onDelete: Cascade)

  @@id([hospitalId, medicalCenterId])
}

model Clinic {
  id              String        @id @default(cuid())
  hospitalId      String
  medicalCenterId String?
  name            Json
  schedule        Json
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  hospital        Hospital      @relation(fields: [hospitalId], references: [id], onDelete: Cascade)
  medicalCenter   MedicalCenter? @relation(fields: [medicalCenterId], references: [id], onDelete: SetNull)
  appointments    AppointmentRequest[]

  @@index([hospitalId])
  @@index([medicalCenterId])
}


model Doctor {
  id           String                @id @default(cuid())
  slug         String                @unique
  name         Json
  title        Json?
  specialty    Json?
  photo        String?
  bio          Json?
  isFeatured   Boolean               @default(false)
  status       ContentStatus         @default(DRAFT)
  customFields Json?                 @default("{}")
  createdAt    DateTime              @default(now())
  updatedAt    DateTime              @updatedAt
  appointments AppointmentRequest[]
  hospitals    DoctorHospital[]
  centers      DoctorMedicalCenter[]
  reviews      DoctorReview[]

  @@index([status])
  @@index([isFeatured])
}

model DoctorHospital {
  doctorId   String
  hospitalId String
  doctor     Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  hospital   Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@id([doctorId, hospitalId])
}

model DoctorMedicalCenter {
  doctorId        String
  medicalCenterId String
  doctor          Doctor        @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  medicalCenter   MedicalCenter @relation(fields: [medicalCenterId], references: [id], onDelete: Cascade)

  @@id([doctorId, medicalCenterId])
}

model NewsCategory {
  id    String     @id @default(cuid())
  name  Json
  slug  String     @unique
  posts NewsPost[]
}

model NewsPost {
  id                String          @id @default(cuid())
  slug              String          @unique
  title             Json
  excerpt           Json?
  body              Json?
  featuredImage     String?
  categoryId        String?
  authorId          String?
  status            ContentStatus   @default(DRAFT)
  sourceType        NewsSourceType  @default(MANUAL)
  sourcePlatform    SocialPlatform?
  sourceBrandId     String?
  externalPostId    String?
  externalPermalink String?
  syncedAt          DateTime?
  relatedHospitalId String?
  metaTitle         Json?
  metaDescription   Json?
  publishedAt       DateTime?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  category          NewsCategory?   @relation(fields: [categoryId], references: [id])
  relatedHospital   Hospital?       @relation(fields: [relatedHospitalId], references: [id])
  sourceBrand       Brand?          @relation(fields: [sourceBrandId], references: [id])

  @@unique([sourcePlatform, externalPostId])
  @@index([status, publishedAt])
  @@index([sourceType])
  @@index([categoryId])
  @@index([sourceBrandId])
}

model MediaFolder {
  id        String        @id @default(cuid())
  name      String
  parentId  String?
  createdAt DateTime      @default(now())
  media     Media[]
  parent    MediaFolder?  @relation("FolderTree", fields: [parentId], references: [id])
  children  MediaFolder[] @relation("FolderTree")

  @@index([parentId])
}

model Media {
  id         String       @id @default(cuid())
  url        String
  type       MediaType
  altText    Json?
  tags       String[]
  folderId   String?
  sizeBytes  Int?
  width      Int?
  height     Int?
  uploadedBy String?
  createdAt  DateTime     @default(now())
  folder     MediaFolder? @relation(fields: [folderId], references: [id])

  @@index([folderId])
  @@index([type])
}

model NavigationItem {
  id        String           @id @default(cuid())
  label     Json
  target    String
  parentId  String?
  location  String
  order     Int
  isVisible Boolean          @default(true)
  parent    NavigationItem?  @relation("NavTree", fields: [parentId], references: [id])
  children  NavigationItem[] @relation("NavTree")

  @@index([location, order])
  @@index([parentId])
}

model Setting {
  key       String   @id
  group     String
  value     Json
  updatedAt DateTime @updatedAt
}

model IntegrationSetting {
  id                  String               @id @default(cuid())
  provider            String               @unique
  encryptedValue      String
  isActive            Boolean              @default(true)
  updatedAt           DateTime             @updatedAt
  brandSocialAccounts BrandSocialAccount[]
}

model AppointmentRequest {
  id              String            @id @default(cuid())
  name            String
  phone           String
  email           String?
  hospitalId      String?
  medicalCenterId String?
  clinicId        String?
  doctorId        String?
  preferredDate   DateTime?
  message         String?
  answers         Json?
  notes           String?
  status          AppointmentStatus @default(NEW)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  doctor          Doctor?           @relation(fields: [doctorId], references: [id])
  clinic          Clinic?           @relation(fields: [clinicId], references: [id])
  hospital        Hospital?         @relation(fields: [hospitalId], references: [id])
  medicalCenter   MedicalCenter?    @relation(fields: [medicalCenterId], references: [id])
  review          DoctorReview?
  conversation    ChatConversation?

  @@index([status])
  @@index([createdAt])
  @@index([hospitalId])
  @@index([medicalCenterId])
  @@index([clinicId])
  @@index([doctorId])
}

model BookingQuestion {
  id              String        @id @default(cuid())
  medicalCenterId String
  questionText    Json          // { ar: string, en: string }
  questionType    String        // "text", "select", "radio", "checkbox"
  options         Json?         // Array of { label: { ar, en }, value: string } (for select/radio/checkbox)
  isRequired      Boolean       @default(true)
  order           Int           @default(0)
  isActive        Boolean       @default(true)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  medicalCenter   MedicalCenter @relation(fields: [medicalCenterId], references: [id], onDelete: Cascade)
}

model ContactSubmission {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String?
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([isRead])
}

model Testimonial {
  id        String              @id @default(cuid())
  name      Json
  audience  TestimonialAudience
  quote     Json
  photo     String?
  status    ContentStatus       @default(DRAFT)
  order     Int                 @default(0)
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  before    Json?
  after     Json?
  ipAddress String?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@index([action])
}

/// One conversation on one surface. `brandId` + `channel` identify the surface;
/// `scopeState` + `resolvedHospitalId` carry the knowledge scope. See
/// `Docs/RECEPTIONIST_ARCHITECTURE.md` §2.
model ChatConversation {
  id        String        @id @default(cuid())
  visitorId String
  locale    String        @default("ar")

  // ─── Surface identity ───
  brandId    String?
  channel    ChatChannel @default(WEB)
  /// Messenger PSID. Null on WEB — a web visitor cannot be messaged back.
  externalId String?

  // ─── Knowledge scope (§2, §3) ───
  scopeState         ConversationScopeState @default(UNRESOLVED)
  resolvedHospitalId String?

  // ─── Qualification ───
  leadStatus LeadStatus @default(INFORMATION_ONLY)
  /// Collected slots: name, phone, specialty, branch, date, time,
  /// visitType, doctorPreference, reason.
  slots      Json       @default("{}")

  // ─── Lifecycle ───
  lastMessageAt        DateTime?
  handedOffAt          DateTime?
  appointmentRequestId String?   @unique

  startedAt DateTime      @default(now())
  endedAt   DateTime?
  messages  ChatMessage[]

  brand              Brand?              @relation(fields: [brandId], references: [id], onDelete: SetNull)
  resolvedHospital   Hospital?           @relation(fields: [resolvedHospitalId], references: [id], onDelete: SetNull)
  appointmentRequest AppointmentRequest? @relation(fields: [appointmentRequestId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([brandId, channel])
  @@index([channel, externalId])
  @@index([leadStatus])
  @@index([lastMessageAt])
}

model ChatMessage {
  id             String           @id @default(cuid())
  conversationId String
  sender         ChatSender
  content        String
  matchedKbId    String?
  isUnanswered   Boolean          @default(false)
  isFallback     Boolean          @default(false)
  createdAt      DateTime         @default(now())

  // ─── Grounding contract (§9) ───
  /// IDs of the records this reply's factual claims were drawn from.
  /// Empty on a reply that asserts no facts.
  citedRecordIds String[] @default([])
  safetyFlag     SafetyFlag?

  // ─── Observability. `cachedTokens` is the gate in §10: below a 70%
  //     cache-read ratio, a silent invalidator is in the prefix.
  modelUsed    String?
  inputTokens  Int?
  outputTokens Int?
  cachedTokens Int?
  latencyMs    Int?

  conversation ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([isUnanswered])
  @@index([safetyFlag])
}

/// Geography → hospital routing for the INSAN (ROUTER) surfaces. §8.
/// `district = ""` means the row covers the whole governorate.
/// No match is NOT an error — it yields `AMBIGUOUS`, and the receptionist
/// names the options instead of guessing.
model ServiceArea {
  id          String   @id @default(cuid())
  hospitalId  String
  governorate String
  district    String   @default("")
  /// Lower wins when both hospitals cover the same area.
  priority    Int      @default(1)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  hospital Hospital @relation(fields: [hospitalId], references: [id], onDelete: Cascade)

  @@unique([hospitalId, governorate, district])
  @@index([governorate, district])
  @@index([isActive])
}

/// Prompt layer 2 (§5): brand voice and brand business rules, kept in separate
/// columns because they have separate owners — voice belongs to the brand
/// owner, rules belong to operations.
model BrandPersona {
  id      String @id @default(cuid())
  brandId String @unique

  entryMode EntryMode @default(DIRECT)
  /// What the receptionist calls itself, per locale.
  displayName Json
  greeting    Json
  /// Voice, tone, register. Brand owner edits this.
  persona       String
  /// Operating rules: what it may promise, escalation triggers, working
  /// hours language. Operations edits this.
  businessRules String

  isActive  Boolean  @default(true)
  version   Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  brand Brand @relation(fields: [brandId], references: [id], onDelete: Cascade)

  @@index([isActive])
}

model AiKnowledgeBase {
  id        String   @id @default(cuid())
  topic     Json
  question  Json
  answer    Json
  category  String?
  isActive  Boolean  @default(true)
  embedding Unsupported("vector")?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
}

model AiProvider {
  id        String   @id @default(cuid())
  name      String   @unique
  baseUrl   String?
  apiKey    String
  modelName String
  priority  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, priority])
}

model AiSettings {
  key   String @id
  value Json
}

model FaqItem {
  id        String   @id @default(cuid())
  topic     Json
  question  Json
  answer    Json
  order     Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive])
  @@index([order])
}

enum RoleName {
  SUPER_ADMIN
  ADMIN
  MANAGER
  EDITOR
  VIEWER
}

enum ContentStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum NewsSourceType {
  MANUAL
  SOCIAL_SYNC
}

enum SocialPlatform {
  FACEBOOK
  INSTAGRAM
  LINKEDIN
}

enum AppointmentStatus {
  NEW
  CONTACTED
  CONFIRMED
  CANCELLED
  COMPLETED
  ATTENDED
  NO_SHOW
}

enum TestimonialAudience {
  INVESTOR
  DOCTOR
  PATIENT
}

enum ChatSender {
  USER
  AI
  SYSTEM
}

enum ChatChannel {
  WEB
  MESSENGER
  WHATSAPP
  INSTAGRAM
  VOICE
}

/// UNRESOLVED — ROUTER surface, no hospital determined yet.
/// ECOSYSTEM  — platform-level questions; never needs a hospital.
/// RESOLVED   — scoped to `resolvedHospitalId`; every query is filtered by it.
/// AMBIGUOUS  — geography matched nothing or matched both; ask, never guess.
enum ConversationScopeState {
  UNRESOLVED
  ECOSYSTEM
  RESOLVED
  AMBIGUOUS
}

/// DIRECT — a hospital page: scope is fixed at conversation creation.
/// ROUTER — INSAN: scope is resolved lazily, on service intent.
enum EntryMode {
  DIRECT
  ROUTER
}

enum LeadStatus {
  INFORMATION_ONLY
  INTERESTED
  WARM_LEAD
  READY_TO_BOOK
  NEEDS_HUMAN
  EMERGENCY
  SPAM
  ABUSIVE
}

enum SafetyFlag {
  EMERGENCY
  ABUSE
  SPAM
  GROUNDING_FAILURE
}

enum MediaType {
  IMAGE
  VIDEO
  PDF
  DOCUMENT
}

model DoctorReview {
  id            String             @id @default(cuid())
  doctorId      String
  appointmentId String?            @unique
  phone         String
  rating        Int                @default(5)
  comment       String?
  status        ReviewStatus       @default(PENDING)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  doctor        Doctor             @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  appointment   AppointmentRequest? @relation(fields: [appointmentId], references: [id], onDelete: SetNull)

  @@index([doctorId])
  @@index([phone])
  @@index([status])
}

enum ReviewStatus {
  PENDING
  APPROVED
  REJECTED
}
