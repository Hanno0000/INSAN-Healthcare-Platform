modules = ["nodejs-20", "web", "postgresql-16"]

[nix]
channel = "stable-25_05"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "INSAN API (NestJS)"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "INSAN API (NestJS)"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/api && pnpm run dev"
waitForPort = 4000

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd apps/web && pnpm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[userenv]

[userenv.shared]
CORS_ORIGIN = "http://localhost:5000"
JWT_ACCESS_EXPIRES = "15m"
JWT_REFRESH_EXPIRES = "7d"
LLM_PROVIDER = "anthropic"
NEXT_PUBLIC_API_BASE_URL = "http://localhost:4000/api/v1"
NEXT_PUBLIC_DEFAULT_LOCALE = "ar"
NEXT_PUBLIC_SITE_URL = "https://insan-platform.com"
NODE_ENV = "development"
PORT = "4000"
RATE_LIMIT_MAX = "100"
RATE_LIMIT_WINDOW = "15m"
S3_BUCKET = "insan-media"
ENCRYPTION_KEY = "76e535a68c36be7f66d9dcf7c06ee6027e1f2afb1adabff102f0e8396d9a9edd"
JWT_ACCESS_SECRET = "ac3569763856d245e058d96460b89fe1fdb11fe0a1199e6f19336e4027a50a82"
JWT_REFRESH_SECRET = "af3d1d0617588e231f3cb5adf558f5654e0831798d927e69f2f2186e97e4851d"

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 180000

[[ports]]
localPort = 4000
externalPort = 3000

[[ports]]
localPort = 5000
externalPort = 80
