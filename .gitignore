# Secrets and dependencies — never commit these
.env
.env.*
!.env.example
!.env.*.example
node_modules
.cache

# Local working directory. Work orders drafted here routinely carry live tokens
# and secrets in plaintext before they are handed to an operator — e.g. the
# Messenger verify token in WORK_ORDER_MESSENGER_GO_LIVE.md. This repository is
# public, so an untracked scratch/ was one `git add -A` away from publishing
# them.
scratch/

# Binaries
*.xlsx
*.gsheet
*.ai
*.eps
*.pdf
*.pptx
*.psd
*.zip

# Media — never pushed.
#
# This repository is public. Photography and video of the two hospitals is real
# facility material, some of it showing identifiable patients, and publishing it
# is not a side effect anyone should be able to cause with `git add -A`.
# What gets pushed is the project itself: code, documentation, structure, specs,
# prompts and the knowledge Markdown. Media lives on Drive, which is where the
# workers read it from anyway — nothing breaks by keeping it out of git.
#
# Note: this does not untrack what was committed before the rule existed —
# 66 .png, 6 .ai, 5 .svg and 3 .jpeg under business/brand/logos/ are already in
# the public history and staying there is a separate decision.
*.jpeg
*.jpg
*.png
*.gif
*.webp
*.bmp
*.tif
*.tiff
*.heic
*.heif
*.mp4
*.mov
*.avi
*.mkv
*.webm
*.m4v
*.mp3
*.wav
*.m4a
*.aac

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Archive (deprecated files)
archive/

# Generated assets (large files)
assets/generated/
campaign-os/visual-assets/

# Google Drive sync folders (root only)
/Docs/
/Prompts/
/AppsScript/
